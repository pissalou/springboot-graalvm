<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/global.css">
    <!-- Dynamically loaded page-specific CSS -->
    {{#pageCss}}<link rel="stylesheet" href="/css/pages/{{pageCss}}">{{/pageCss}}
</head>
<body>
    <main>{{{mainContent}}}</main>
    
    <!-- Core global JS -->
    <script src="/js/global.js"></script>
    <!-- Dynamically loaded page-specific JS -->
    {{#pageJs}}<script src="/js/pages/{{pageJs}}"></script>{{/pageJs}}
</body>
</html>

