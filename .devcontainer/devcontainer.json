{
  "name": "GraalVM Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "privileged": true,
  "forwardPorts": [],
  "postCreateCommand": "mvn dependency:go-offline",
  "containerEnv": {
    "MAVEN_OPTS": "-Dmaven.offline=true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ]
    }
  }
}
