{
  "name": "GraalVM Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  runArgs: [
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "privileged": true,
  "containerUser": "dev",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "forwardPorts": [],
  "postCreateCommand": "mvn dependency:collect dependency:go-offline && test \"$(stat -c '%u:%g' .)\" = \"1000:1000\" || (cat /proc/self/uid_map && id -u)",
  "containerEnv": {
    "MAVEN_ARGS": "-Dmaven.offline=true",
  },
  "customizations": {
    "jetbrains": {
      "backend": "CLion",
      "plugins": [
        "com.github.copilot"
      ]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ]
    }
  }
}
